  { id: "Hot Coffee", en: "Hot Coffee", az: "İsti qəhvələr" },
  { id: "Iced Coffee", en: "Iced Coffee", az: "Soyuq qəhvələr" },
  { id: "Matcha & Tea", en: "Matcha & Tea", az: "Matcha və çay" },
  { id: "Frappe", en: "Frappe", az: "Frappé" },
  { id: "Chocolate", en: "Chocolate", az: "Şokolad" },
