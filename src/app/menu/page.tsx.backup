import { useLanguage } from "@/context/LanguageContext";
import Link from "next/link";
import { addToCart, getCart } from "@/lib/cart";
import {
  House, Coffee, Gift, Info, Search, ArrowLeft
} from "lucide-react";

type Lang = "AZ" | "EN";

import { products, type Product } from "@/data/products";

