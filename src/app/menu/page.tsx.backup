                      className="flex h-9 w-9 items-center justify-center rounded-full bg-[#553b2c] text-white transition hover:bg-[#9b7251]"
                    >
                      +
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div className="rounded-3xl bg-white px-6 py-16 text-center">
            <Coffee size={35} className="mx-auto text-[#b58b65]" />
            <h3 className="mt-4 text-xl font-black">{t.noProducts}</h3>
            <p className="mt-2 text-sm text-[#9a8879]">{t.tryAgain}</p>
            <button
