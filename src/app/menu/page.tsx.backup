                      : product.category}
                  </p>

                  <h4 className="mt-2 text-sm font-black md:text-base">
                    {lang === "AZ" ? product.az : product.en}
                  </h4>

                  <p className="mt-2 min-h-10 text-xs leading-5 text-[#9a8879]">
                    {lang === "AZ" ? product.descAz : product.descEn}
                  </p>

                  <div className="mt-4 flex items-center justify-between">
                    <p className="font-black">{product.price.toFixed(2)} ₼</p>
                    <button
                      aria-label={t.add}
