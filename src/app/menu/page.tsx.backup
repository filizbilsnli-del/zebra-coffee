  }

  const t = text[lang];

  const filteredProducts = products.filter((product) => {
    const matchesCategory =
      activeCategory === "All" || product.category === activeCategory;

    const name = lang === "AZ" ? product.az : product.en;
    const description = lang === "AZ" ? product.descAz : product.descEn;

    const matchesSearch =
      `${name} ${description}`.toLowerCase().includes(search.toLowerCase());

    return matchesCategory && matchesSearch;
  });

  return (
    <main className="min-h-screen bg-[#faf7f1] pb-28 text-[#38271f]">
      <header className="sticky top-0 z-40 border-b border-[#e9dfd2] bg-[#faf7f1]/95 backdrop-blur-xl">
        <div className="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 md:px-10">
          <Link href="/" className="flex items-center gap-3">
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#553b2c] text-xl font-black text-[#f5e7d1]">
              Z
            </div>
            <div>
              <h1 className="text-xl font-black tracking-[0.16em]">ZEBRA</h1>
              <p className="text-[9px] font-bold tracking-[0.35em] text-[#9a7559]">
                COFFEE HOUSE
              </p>
            </div>
          </Link>

          <div className="flex items-center gap-2">
          </div>
        </div>
      </header>

      <section className="mx-auto max-w-7xl px-5 pb-8 pt-12 md:px-10">
        <Link
          href="/"
          className="mb-7 inline-flex items-center gap-2 text-sm font-semibold text-[#94765e]"
        >
          <ArrowLeft size={17} /> {t.back}
        </Link>

        <p className="text-xs font-black tracking-[0.3em] text-[#a17c5d]">
          {t.made}
        </p>

        <h2 className="mt-3 text-4xl font-black md:text-6xl">
          {t.title}<span className="text-[#b58b65]">.</span>
        </h2>

        <p className="mt-4 max-w-xl text-sm leading-7 text-[#8c7869] md:text-base">
          {t.subtitle}
        </p>
      </section>

      <section className="mx-auto max-w-7xl px-5 md:px-10">
        <div className="flex items-center gap-3 rounded-2xl border border-[#e8ded2] bg-white px-5 py-4">
          <Search size={20} className="text-[#9b8069]" />
          <input
            type="text"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder={t.search}
            className="w-full bg-transparent text-sm outline-none placeholder:text-[#b5a394]"
          />
        </div>
      </section>

      <section className="mx-auto max-w-7xl px-5 pt-8 md:px-10">
        <div className="flex gap-3 overflow-x-auto pb-4">
          <button
            onClick={() => setActiveCategory("All")}
            className={`shrink-0 rounded-full px-5 py-3 text-xs font-bold transition ${
              activeCategory === "All"
                ? "bg-[#553b2c] text-white shadow-md"
                : "border border-[#e8ded2] bg-white text-[#806c5d]"
            }`}
          >
            {t.all}
          </button>

          {categoryData.map((category) => (
            <button
              key={category.id}
              onClick={() => setActiveCategory(category.id)}
              className={`shrink-0 rounded-full px-5 py-3 text-xs font-bold transition ${
                activeCategory === category.id
                  ? "bg-[#553b2c] text-white shadow-md"
                  : "border border-[#e8ded2] bg-white text-[#806c5d]"
              }`}
            >
              {lang === "AZ" ? category.az : category.en}
            </button>
          ))}
        </div>
      </section>

      <section className="mx-auto max-w-7xl px-5 pb-16 pt-5 md:px-10">
        <div className="mb-7">
          <h3 className="text-xl font-black md:text-2xl">
            {activeCategory === "All"
              ? t.all
              : lang === "AZ"
                ? categoryData.find((c) => c.id === activeCategory)?.az
                : categoryData.find((c) => c.id === activeCategory)?.en}
          </h3>
        </div>

        {filteredProducts.length > 0 ? (
          <div className="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6 lg:grid-cols-4">
            {filteredProducts.map((product) => (
              <article
                key={product.id}
                className="group overflow-hidden rounded-[25px] border border-[#eee5d9] bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
              >
                <div className="h-40 overflow-hidden bg-[#eee3d5] md:h-56">
                  <img
                    src={product.image}
                    alt={lang === "AZ" ? product.az : product.en}
                    loading="lazy"
                    className="h-full w-full object-cover transition duration-500 group-hover:scale-110"
                  />
                </div>

                <div className="p-4 md:p-5">
                  <p className="text-[10px] font-bold uppercase tracking-widest text-[#a58b76]">
                    {lang === "AZ"
