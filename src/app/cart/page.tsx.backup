"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { ArrowLeft, Coffee, Minus, Plus, ShoppingBag, Trash2 } from "lucide-react";
import { CartItem, getCart, saveCart } from "@/lib/cart";

type Lang = "AZ" | "EN";

const translations = {
  AZ: {
    title: "Səbətim",
    subtitle: "Seçdiyiniz dadlar sizi gözləyir.",
    empty: "Səbətiniz hələ boşdur",
    emptyText: "Sevimli qəhvələrinizi seçmək üçün menyumuza keçin.",
    menu: "Menyuya qayıt",
    total: "Ümumi məbləğ",
    checkout: "Sifarişi davam et",
    remove: "Sil",
    back: "Menyuya qayıt",
  },
  EN: {
    title: "My Cart",
    subtitle: "Your selected favorites are waiting for you.",
    empty: "Your cart is empty",
    emptyText: "Visit our menu and choose your favorite coffee.",
    menu: "Back to Menu",
    total: "Total",
    checkout: "Continue to checkout",
    remove: "Remove",
    back: "Back to Menu",
  },
};

export default function CartPage() {
  const [lang, setLang] = useState<Lang>("AZ");
  const [items, setItems] = useState<CartItem[]>([]);
  const [loaded, setLoaded] = useState(false);

  const t = translations[lang];

  useEffect(() => {
    setItems(getCart());
    setLoaded(true);
  }, []);

  function updateQuantity(id: number, change: number) {
    const updated = items
      .map((item) =>
        item.id === id
          ? { ...item, quantity: item.quantity + change }
          : item
      )
      .filter((item) => item.quantity > 0);

    setItems(updated);
    saveCart(updated);
  }

  function removeItem(id: number) {
    const updated = items.filter((item) => item.id !== id);
    setItems(updated);
    saveCart(updated);
  }

  const total = items.reduce(
    (sum, item) => sum + item.price * item.quantity,
    0
  );

  const itemCount = items.reduce((sum, item) => sum + item.quantity, 0);

  if (!loaded) {
    return <main className="min-h-screen bg-[#faf7f1] pb-28" />;
  }

  return (
    <main className="min-h-screen bg-[#faf7f1] px-5 py-8 pb-28 text-[#38271f] md:px-10">
      <div className="mx-auto max-w-5xl">
        <header className="mb-10 flex items-center justify-between">
          <Link href="/" className="flex items-center gap-3">
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#553b2c] text-xl font-black text-[#f5e7d1]">
              Z
            </div>
            <div>
              <h1 className="text-xl font-black tracking-[0.16em]">ZEBRA</h1>
              <p className="text-[9px] font-bold tracking-[0.35em] text-[#9a7559]">
                COFFEE HOUSE
              </p>
            </div>
          </Link>

          <div className="flex rounded-full border border-[#e8ded2] bg-white p-1 text-xs font-black">
            <button
              onClick={() => setLang("AZ")}
              className={`rounded-full px-3 py-2 ${lang === "AZ" ? "bg-[#553b2c] text-white" : "text-[#806c5d]"}`}
            >
              AZ
            </button>
            <button
              onClick={() => setLang("EN")}
              className={`rounded-full px-3 py-2 ${lang === "EN" ? "bg-[#553b2c] text-white" : "text-[#806c5d]"}`}
            >
              EN
            </button>
          </div>
        </header>

        <Link
          href="/menu"
          className="mb-8 inline-flex items-center gap-2 text-sm font-bold text-[#9a7559] transition hover:text-[#553b2c]"
        >
          <ArrowLeft size={17} />
          {t.back}
        </Link>

        <div className="mb-8">
          <div className="mb-3 flex items-center gap-3">
            <ShoppingBag size={27} />
            <h2 className="text-3xl font-black md:text-4xl">{t.title}</h2>
            {itemCount > 0 && (
              <span className="rounded-full bg-[#eee3d5] px-3 py-1 text-sm font-bold">
                {itemCount}
              </span>
            )}
          </div>
          <p className="text-sm text-[#8b7768]">{t.subtitle}</p>
        </div>

        {items.length === 0 ? (
          <section className="rounded-[28px] border border-[#eee5d9] bg-white px-6 py-16 text-center shadow-sm">
            <div className="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-[#f5eee5] text-[#9b7251]">
              <Coffee size={34} />
            </div>
            <h3 className="mb-2 text-2xl font-black">{t.empty}</h3>
            <p className="mx-auto mb-7 max-w-md text-sm text-[#8b7768]">
              {t.emptyText}
            </p>
            <Link
              href="/menu"
              className="inline-flex rounded-full bg-[#553b2c] px-7 py-3 text-sm font-bold text-white transition hover:bg-[#9b7251]"
            >
              {t.menu}
            </Link>
          </section>
        ) : (
          <div className="grid gap-7 lg:grid-cols-[1fr_340px]">
            <section className="space-y-4">
              {items.map((item) => (
                <article
                  key={item.id}
                  className="flex gap-4 rounded-[24px] border border-[#eee5d9] bg-white p-4 shadow-sm sm:gap-6 sm:p-5"
                >
                  <img
                    src={item.image.startsWith("/") ? item.image : `/images/${item.image}`}
                    alt={lang === "AZ" ? item.az : item.en}
                    className="h-24 w-24 rounded-2xl object-cover sm:h-28 sm:w-28"
                  />

                  <div className="min-w-0 flex-1">
                    <h3 className="font-black sm:text-lg">
                      {lang === "AZ" ? item.az : item.en}
                    </h3>
                    <p className="mt-1 text-sm font-bold text-[#9b7251]">
                      {item.price.toFixed(2)} AZN
                    </p>

                    <div className="mt-4 flex flex-wrap items-center justify-between gap-3">
                      <div className="flex items-center gap-3 rounded-full bg-[#f5eee5] p-1">
                        <button
                          onClick={() => updateQuantity(item.id, -1)}
                          aria-label="Decrease quantity"
                          className="flex h-8 w-8 items-center justify-center rounded-full bg-white"
                        >
                          <Minus size={15} />
                        </button>
                        <span className="min-w-4 text-center text-sm font-black">
                          {item.quantity}
                        </span>
                        <button
                          onClick={() => updateQuantity(item.id, 1)}
                          aria-label="Increase quantity"
                          className="flex h-8 w-8 items-center justify-center rounded-full bg-white"
                        >
                          <Plus size={15} />
                        </button>
                      </div>

                      <button
                        onClick={() => removeItem(item.id)}
                        aria-label={t.remove}
                        className="flex items-center gap-1 text-xs font-bold text-[#a46c5b] transition hover:text-red-700"
                      >
                        <Trash2 size={15} />
                        {t.remove}
                      </button>
                    </div>
                  </div>

                  <div className="hidden text-right font-black sm:block">
                    {(item.price * item.quantity).toFixed(2)} AZN
                  </div>
                </article>
              ))}
            </section>

            <aside className="h-fit rounded-[26px] border border-[#eee5d9] bg-white p-6 shadow-sm">
              <h3 className="mb-6 text-xl font-black">{t.total}</h3>
              <div className="mb-6 flex items-center justify-between border-t border-[#eee5d9] pt-5">
                <span className="text-sm text-[#8b7768]">{t.total}</span>
                <span className="text-2xl font-black text-[#553b2c]">
                  {total.toFixed(2)} AZN
                </span>
              </div>
              <button
                disabled
                className="w-full cursor-not-allowed rounded-full bg-[#c9b9a9] px-5 py-4 text-sm font-bold text-white"
              >
                {t.checkout}
              </button>
              <p className="mt-3 text-center text-xs text-[#9a8879]">
                {lang === "AZ"
                  ? "Sifariş funksiyası növbəti mərhələdə aktiv ediləcək."
                  : "The order feature will be activated in the next step."}
              </p>
            </aside>
          </div>
        )}
      </div>
    </main>
  );
}

